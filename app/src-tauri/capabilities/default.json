{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "google-auth:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}